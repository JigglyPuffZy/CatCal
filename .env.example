# Local development — copy to .env and set your PC's LAN IP for phone testing
EXPO_PUBLIC_API_URL=http://192.168.1.100:3001

# Release builds use https://catcal-api.onrender.com from eas.json (after backend is deployed).
# Override only if your deployed API URL is different:
# EXPO_PUBLIC_API_URL=https://your-api.onrender.com
